# ==========================================
# BASE DE DATOS (Prisma)
# ==========================================
# En local, SQLite es suficiente y no requiere configuración adicional.
# En producción (Vercel), SQLite NO persiste entre despliegues: usa
# Postgres (ej. Vercel Postgres, Supabase o Neon) y cambia el
# datasource en prisma/schema.prisma de "sqlite" a "postgresql".
DATABASE_URL="file:./dev.db"

# ==========================================
# TRANSBANK WEBPAY PLUS
# ==========================================
# Déjalas vacías para usar automáticamente las credenciales de
# integración (sandbox) que trae el SDK. Complétalas solo cuando
# tengas tu afiliación comercial real aprobada por Transbank.
TBK_COMMERCE_CODE=
TBK_API_KEY=

# ==========================================
# RESEND (envío de correos de cotización y confirmación de pedido)
# ==========================================
# Crea una cuenta gratis en https://resend.com, verifica tu dominio
# y genera una API key. Sin esto, el envío de correos fallará.
RESEND_API_KEY=

# ==========================================
# CONFIGURACIÓN DE LA TIENDA
# ==========================================
NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678
CONTACT_EMAIL=contacto@rdspring.cl

# ==========================================
# PANEL DE ADMINISTRACIÓN (/admin/pedidos)
# ==========================================
# Clave para entrar al panel donde marcas los pedidos como
# "En camino" o "Entregado". Cámbiala por algo largo y único,
# no la compartas ni la subas a git.
ADMIN_SECRET=cambia-esto-por-una-clave-larga-y-secreta
