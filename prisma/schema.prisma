generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- 1. NUEVO MODELO DE USUARIOS ---
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   
  role      String   @default("CUSTOMER") 
  createdAt DateTime @default(now())
  
  orders    Order[]  
}

// --- 2. MODELO DE ÓRDENES ACTUALIZADO ---
model Order {
  id             String   @id @default(cuid())
  buyOrder       String   @unique
  token          String?  @unique
  amount         Int
  status         String   @default("PENDING")
  shippingStatus String   @default("CONFIRMADO")
  
  customer       String   
  
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  
  items          String
  
  // --- NUEVOS CAMPOS PARA BOLETA/FACTURA ---
  documentType   String   @default("BOLETA")
  razonSocial    String?
  giro           String?
  
  createdAt      DateTime @default(now())
}

// --- 3. MODELO DE PRODUCTOS ---
model Product {
  id    String @id
  sku   String @unique
  stock Int    @default(0)
}